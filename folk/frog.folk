Wish $this is titled "Origami Frog tutorial"
Wish $this is outlined gray

# TODO: Allow setting this to a US Letter sie of paper as well.
# set width 85
# set height 110
set width 300
set height 500

# Card position - single expression evaluation
set cardX [expr {$width * 1.1}]
set cardY 0

set quarterWidth [expr {$width / 4.0}]
set quarterHeight [expr {$height / 4.0}]

When /nobody/ claims the frog tutorial step is /fts/ {
    Hold {
        Claim the frog tutorial step is 5
    }
}

When /someone/ claims the frog tutorial step is /fts/ & $this has region /r/ {
    set c [region centroid $r]
    set a [region angle $r]

    # Calculate width-based values once
    set cardWidth [expr {$cardX + $width}]
    set cardHeight [expr {$cardY + $height}]

    # Define corner coordinates 
    set topLeft [list $cardX $cardY]
    set topRight [list $cardWidth $cardY]
    set botLeft [list $cardX $cardHeight]
    set botRight [list $cardWidth $cardHeight]

    # Calculate midpoints more directly
    set rightMidpoint [list $cardWidth [expr {$cardY + $height/2.0}]]
    set leftMidpoint [list $cardX [expr {$cardY + $height/2.0}]]
    set midpointTop [list [expr {$cardX + $width/2.0}] $cardY]

    # Center calculation
    set frogCenter [list [expr {$cardX + $width/2.0}] [expr {$cardY + $height/2.0}]]

    # Wish $this draws a set of points [list $topLeft $topRight $botLeft $botRight] with color green radius 8 filled false thickness 5

    set frogTutorialStep $fts

    switch $frogTutorialStep {
        1 {
            Wish $this is labelled "Step 1: Place an index card in the box to the right,\nfold the top right corner of the index card."
            Wish $this draws a polyline [list $topLeft $rightMidpoint ] with color yellow thickness 5 dashed true dashlength 15 dashoffset 50
            Wish $this draws a polyline [list $topLeft $topRight $botRight $botLeft $topLeft] with color white radius 8 filled false thickness 5
        }
        2 {
            Wish $this is labelled "Step 2: Fold the top left corner down."
            Wish $this draws a polyline [list $topRight $leftMidpoint] with color yellow thickness 5 dashed true dashlength 15 dashoffset 50
            Wish $this draws a polyline [list $topLeft $topRight $botRight $botLeft $topLeft] with color white radius 8 filled false thickness 5
        }
        3 {
            Wish $this is labelled "Step 3: Push the two triangles on the\nright inward to make this house shape."
            # Wish $this draws a polyline [list $topLeft $topRight $botRight $botLeft $topLeft] with color blue radius 8 filled false thickness 20 layer -1
            Wish $this draws a polyline [list $botRight $botLeft $leftMidpoint $midpointTop $rightMidpoint $botRight] with color white radius 8 filled false thickness 5
        }
        4 {
            Wish $this is labelled "Step 4: Fold the left and right sides\nof the top triangle toward the center."
            # Wish $this draws a polyline [list $topLeft $topRight $botRight $botLeft $topLeft] with color blue radius 8 filled false thickness 20 layer -1
            # TODO: Figure out points for drawing the front-leg-fold lines.

            set leftLeg [vec2 add $frogCenter [list $quarterWidth -$quarterHeight]]
            set rightLeg [vec2 add $frogCenter [list -$quarterWidth -$quarterHeight]]

            Wish $this draws a polyline [list $frogCenter $leftLeg] with color yellow thickness 5 dashed true dashlength 15 dashoffset 50
            Wish $this draws a polyline [list $frogCenter $rightLeg] with color yellow thickness 5 dashed true dashlength 15 dashoffset 50
            Wish $this draws a polyline [list $botRight $botLeft $leftMidpoint $midpointTop $rightMidpoint $botRight] with color white radius 8  thickness 5
        }
        5 {
            Wish $this is labelled "Step 5: ???"
            # Wish $this draws a polyline [list $topLeft $topRight $botRight $botLeft $topLeft] with color blue radius 8 filled false thickness 20 layer -1
            # TODO: Figure out points for drawing the front-leg-fold lines.

            set leftLeg [vec2 add $frogCenter [list $quarterWidth -$quarterHeight]]
            set rightLeg [vec2 add $frogCenter [list -$quarterWidth -$quarterHeight]]

            Wish $this draws a polyline [list $frogCenter $leftLeg] with color yellow thickness 5 dashed true dashlength 15 dashoffset 50
            Wish $this draws a polyline [list $frogCenter $rightLeg] with color yellow thickness 5 dashed true dashlength 15 dashoffset 50
            Wish $this draws a polyline [list $botRight $botLeft $leftMidpoint $midpointTop $rightMidpoint $botRight] with color white radius 8  thickness 5
        }
        default {
            Wish $this is labelled "You need to:\n`Claim the frog tutorial step is (some number)`"
        }
    }
}