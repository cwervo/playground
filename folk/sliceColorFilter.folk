# slice color filter --
#
#   A standalone Folk program that lets anyone on the table filter an
#   image slice down to just a few colors, on the GPU, via a wish:
#
#       When $thing has slice /s/ {
#           # plain, unfiltered (this already exists in most setups; the
#           # shim at the bottom of this file provides it too, just in case):
#           Wish $thing displays slice $s
#
#           # the new bit --- keep only pixels near one of these colors:
#           Wish $thing displays slice $s with only color: \
#               0x1010FF red green rebeccapurple rgb(255,0,221)
#       }
#
#   Every color in the list is accepted in any of these forms:
#       - a CSS/Folk color name .......... red  green  rebeccapurple
#       - a hex triple ................... 0x1010FF   #1010FF   1010FF
#       - a short hex triple ............. 0x1cf     #1cf     1cf
#       - an rgb() / rgba() triple ....... rgb(255,0,221)   rgba(16,16,255,1)
#         (spaces inside rgb(...) are tolerated too: rgb(255, 0, 221))
#
#   Optionally you can tune how close a pixel has to be to a listed color
#   by dropping a `tolerance:` (a.k.a. `threshold:`) token anywhere in the
#   list. It's a 0..1 RGB distance; the default is $::sliceColorFilter::defaultTolerance.
#
#       Wish $thing displays slice $s with only color: red blue tolerance:0.15
#
#   How it works: for each distinct set of colors we compile a small
#   fragment-shader pipeline (a variant of the builtin "image" pipeline)
#   that samples the slice and discards any pixel whose RGB is farther than
#   `tolerance` from every allowed color. Filtered-out pixels become fully
#   transparent, so whatever is behind the slice shows through.

namespace eval ::sliceColorFilter {
    # Default RGB-distance tolerance (0..1). Pixels within this distance of
    # any requested color are kept; everything else is made transparent.
    variable defaultTolerance 0.25

    # --- Color parsing -----------------------------------------------------

    # Re-join rgb(...) / rgba(...) groups that got split on internal spaces,
    # e.g. {rgb(255, 0, 221)} arriving as {rgb(255,} {0,} {221)}.
    proc normalizeTokens {tokens} {
        set out [list]
        set acc ""
        foreach tok $tokens {
            if {$acc ne ""} {
                append acc $tok
                if {[string match "*)" $tok]} { lappend out $acc; set acc "" }
                continue
            }
            if {[regexp -nocase {^rgba?\(} $tok] && ![string match "*)" $tok]} {
                set acc $tok
                continue
            }
            lappend out $tok
        }
        if {$acc ne ""} { lappend out $acc }
        return $out
    }

    # Parse a single color spec into {r g b} floats in 0..1. Throws on
    # anything it doesn't recognise.
    proc parseColor {spec colorMap} {
        set spec [string trim $spec]

        # rgb(...) / rgba(...) --- components are 0..255, alpha ignored.
        if {[regexp -nocase {^rgba?\(([^)]*)\)$} $spec -> inner]} {
            set parts [split [string map {, " "} $inner]]
            if {[llength $parts] < 3} { error "bad rgb() color: $spec" }
            lassign $parts r g b
            return [list [expr {$r / 255.0}] [expr {$g / 255.0}] [expr {$b / 255.0}]]
        }

        # Hex, with optional 0x / # prefix. 6-digit or 3-digit.
        # (Uses the same 0x-in-expr trick as Folk's builtin `hexcolor`.)
        set hex $spec
        regsub -nocase {^0x} $hex "" hex
        regsub {^#} $hex "" hex
        if {[regexp {^[0-9a-fA-F]{6}$} $hex]} {
            set v 0x$hex
            return [list \
                [expr {(($v >> 16) & 0xFF) / 255.0}] \
                [expr {(($v >> 8)  & 0xFF) / 255.0}] \
                [expr {( $v        & 0xFF) / 255.0}]]
        }
        if {[regexp {^[0-9a-fA-F]{3}$} $hex]} {
            set v 0x$hex
            # Expand each nibble 0xF -> 0xFF by multiplying by 17.
            return [list \
                [expr {((($v >> 8) & 0xF) * 17) / 255.0}] \
                [expr {((($v >> 4) & 0xF) * 17) / 255.0}] \
                [expr {(( $v       & 0xF) * 17) / 255.0}]]
        }

        # Named color, via Folk's color map ({r g b a} in 0..1).
        set key [string tolower $spec]
        if {[dict exists $colorMap $key]} {
            lassign [dict get $colorMap $key] r g b
            return [list $r $g $b]
        }

        error "unknown color: $spec"
    }

    # Split a raw color-list wish tail into {tolerance rgbList}. Recognises an
    # optional tolerance:/threshold: token anywhere in the list.
    proc parseColorList {tokens colorMap} {
        variable defaultTolerance
        set tolerance $defaultTolerance
        set rgbs [list]
        foreach tok [normalizeTokens $tokens] {
            if {[regexp -nocase {^(?:tolerance|threshold)[:=](.+)$} $tok -> t]} {
                set tolerance $t
                continue
            }
            lappend rgbs [parseColor $tok $colorMap]
        }
        return [list $tolerance $rgbs]
    }

    # --- Pipeline construction --------------------------------------------

    # A stable pipeline name for a given tolerance + color set, so identical
    # requests reuse the same compiled shader instead of recompiling.
    proc pipelineName {tolerance rgbs} {
        set parts [lmap c $rgbs {join [lmap v $c {format %.3f $v}] ","}]
        return "sliceColorFilter t=[format %.3f $tolerance] [join $parts " "]"
    }

    # Build the {vertArgs vertBody fragArgs fragBody} source for a filter
    # pipeline with the allowed colors + tolerance baked in as constants.
    # Push constants are identical to the builtin "image" pipeline.
    proc pipelineSource {tolerance rgbs} {
        set n [llength $rgbs]
        set ctor [join [lmap c $rgbs {
            lassign $c r g b
            format "vec3(%.6f, %.6f, %.6f)" $r $g $b
        }] ", "]

        set frag [string map [list \
            @N $n @CTOR $ctor @THRESH [format %.6f $tolerance]] {
            vec2 clipXy = (gl_FragCoord.xy / viewport) * 2.0 - 1.0;
            vec3 surfaceXy = inverse(surfaceToClip) * vec3(clipXy, 1.0);
            surfaceXy /= surfaceXy.z;

            vec2 uv = invBilinear(surfaceXy.xy, a, b, c, d);
            if (max(abs(uv.x - 0.5), abs(uv.y - 0.5)) < 0.5) {
                vec4 texColor = texture(image, uv);

                // Nothing to keep on already-transparent pixels.
                if (texColor.a < 0.01) { return vec4(0.0); }

                vec3 allowed[@N] = vec3[@N](@CTOR);
                float best = 2.0; // max possible RGB distance is sqrt(3) < 2
                for (int i = 0; i < @N; i++) {
                    best = min(best, distance(texColor.rgb, allowed[i]));
                }
                // Too far from every allowed color -> drop the pixel.
                if (best > @THRESH) { return vec4(0.0); }

                return texColor;
            }
            return vec4(0.0);
        }]

        return [list \
            {vec2 viewport mat3 surfaceToClip
             sampler2D image vec2 a vec2 b vec2 c vec2 d} \
            {
                vec2 vertices[6] = vec2[6](a, b, c, a, c, d);
                vec3 v = surfaceToClip * vec3(vertices[gl_VertexIndex], 1.0);
                return vec4(v.xy / v.z, 0.0, 1.0);
            } \
            {fn invBilinear} \
            $frag]
    }
}

# --- The public wish --------------------------------------------------------
#
#   Wish $thing displays slice $s with only color: <color> <color> ...
#
# Anyone on the table can make this wish; we render $s onto their page's
# canvas through a color-filtering shader. Placement mirrors the builtin
# "displays image" (draw/image.folk): topleft-anchored, sized to the page.

When the image library is /imageLib/ &\
     the color map is /colorMap/ &\
     /someone/ wishes /p/ displays slice /s/ with only color: /...colors/ &\
     /p/ has canvas /id/ with /...wiOptions/ &\
     /p/ has canvas projection /surfaceToClip/ &\
     /p/ has resolved geometry /geom/ {

    # HACK: rest patterns can match with the trailing part absent; bail if so.
    if {![info exists colors]} { return }

    if {[catch {::sliceColorFilter::parseColorList $colors $colorMap} res]} {
        Wish $p is labelled "slice color filter: $res"
        return
    }
    lassign $res tolerance rgbs
    if {[llength $rgbs] == 0} { return }

    # Compile (once per distinct color set) the specialized filter pipeline.
    set name [::sliceColorFilter::pipelineName $tolerance $rgbs]
    Wish the GPU compiles pipeline $name \
        [::sliceColorFilter::pipelineSource $tolerance $rgbs]

    # Where to place the slice on the page, keeping the slice's aspect ratio
    # (same sizing logic as builtin draw/image.folk).
    set imgW [$imageLib Image_width $s]
    set imgH [$imageLib Image_height $s]
    if {$imgW <= 0 || $imgH <= 0} { return }

    set width  $(double([dict getdef $geom left [dict get $geom width]]) / 1.5)
    set height $(double($imgH) / $imgW * $width)
    set geomHeight [dict get $geom height]
    if {$height > $geomHeight} {
        set width  $($geomHeight / $height * $width)
        set height $geomHeight
    }

    set x0 0
    set y0 0
    set a [list $x0 $y0]
    set b [list $($x0 + $width) $y0]
    set c [list $($x0 + $width) $($y0 + $height)]
    set d [list $x0 $($y0 + $height)]

    set wiResolution [list [dict get $wiOptions width] [dict get $wiOptions height]]

    # Upload the slice as a GPU texture, then draw it through the filter.
    Wish the GPU loads image $s as texture
    When the GPU has loaded image $s as texture /gim/ {
        Wish the GPU draws pipeline $name onto canvas $id with arguments \
            [list $wiResolution $surfaceToClip $gim $a $b $c $d]
    }
}

# --- Back-compat shim -------------------------------------------------------
#
# Most tables already support `Wish $thing displays slice $s`. If yours
# doesn't, this maps it onto the builtin image display so the plain form in
# the usage example above still works. (Harmless if a real one already
# exists --- identical wishes are deduplicated.)
When /someone/ wishes /p/ displays slice /s/ {
    Wish $p displays image $s
}

Wish $this is titled "slice color filter"
Wish $this is outlined rebeccapurple
Wish $this has text "Wish: displays slice \$s with only color: <colors...>"
