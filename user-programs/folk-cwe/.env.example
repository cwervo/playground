# Copy me into place, then fill in the token:
#
#   mkdir -p ~/folk-data/user-programs/folk-cwe
#   cp .env.example ~/folk-data/user-programs/folk-cwe/.env
#   chmod 600 ~/folk-data/user-programs/folk-cwe/.env
#
# Never commit the real .env -- this token can read your whole inbox.

# REQUIRED: a Gmail OAuth2 access token with read-only scope
# (https://www.googleapis.com/auth/gmail.readonly).
# Quick way (token lasts ~1 hour): https://developers.google.com/oauthplayground
#   Gmail API v1 -> gmail.readonly -> Authorize APIs
#   -> Exchange authorization code for tokens -> copy "Access token"
GMAIL_ACCESS_TOKEN=

# OPTIONAL: let email-piles.folk refresh expired tokens by itself.
# Requires your own Google Cloud OAuth client (see README.md, "Durable
# setup"). With these three set, GMAIL_ACCESS_TOKEN may be left blank.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
