source [file join [file dirname [info script]] harness.tcl]

proc approx {a b {tol 1e-6}} { expr {abs($a - $b) < $tol} }

test budget-1.1 {binomial tail: no loss means everything arrives} -body {
    ioa::budget::binomCdf 100 0.0 0
} -result 1.0

test budget-1.2 {binomial tail: repairing every fragment is certain} -body {
    ioa::budget::binomCdf 10 0.5 10
} -result 1.0

test budget-1.3 {binomial tail matches the hand calculation} -body {
    # P(X <= 1) for X ~ Bin(2, 0.5) is 0.75
    approx [ioa::budget::binomCdf 2 0.5 1] 0.75
} -result 1

test budget-1.4 {binomial tail stays sane at fragment counts real media produce} -body {
    set p [ioa::budget::binomCdf 400 0.01 0]
    expr {$p > 0.01 && $p < 0.02}
} -result 1

test budget-2.1 {fragment count follows the mtu, not the medium} -body {
    set l [ioa::transport::link a b espnow {distance_m 10}]
    set h [ioa::budget::hop $l 40000]
    set room [expr {250 - [ioa::frame::overhead]}]
    expr {[dict get $h fragments] == int(ceil(40000.0 / $room))}
} -result 1

test budget-2.2 {many fragments over a lossy link destroy the picture} -body {
    # The headline problem: a 40 KB JPEG over 250-byte packets at ~1% loss.
    set l [ioa::transport::link a b espnow {distance_m 30}]
    expr {[dict get [ioa::budget::hop $l 40000] delivery] < 0.2}
} -result 1

test budget-2.3 {fec buys the picture back} -body {
    set l [ioa::transport::link a b espnow {distance_m 30}]
    set bare [dict get [ioa::budget::hop $l 40000 1.0] delivery]
    set fec  [dict get [ioa::budget::hop $l 40000 1.25] delivery]
    expr {$fec > $bare && $fec > 0.99}
} -result 1

test budget-2.4 {wire bytes account for headers and repair, and nothing else} -body {
    set l [ioa::transport::link a b wifi_tcp {distance_m 5}]
    set h [ioa::budget::hop $l 10000 1.0]
    expr {[dict get $h wire_bytes] == 10000 + [dict get $h fragments] * [ioa::frame::overhead]}
} -result 1

test budget-2.5 {a small picture is not charged a full mtu per fragment} -body {
    set l [ioa::transport::link a b wifi_tcp {distance_m 5}]
    expr {[dict get [ioa::budget::hop $l 500] overhead_pct] < 10.0}
} -result 1

test budget-3.1 {chooseFec picks the cheapest ratio that clears the target} -body {
    set l [ioa::transport::link a b espnow {distance_m 30}]
    set f [ioa::budget::chooseFec $l 8000 0.95]
    expr {$f > 1.0 && $f <= 1.25}
} -result 1

test budget-3.2 {chooseFec gives up rather than lying} -body {
    # Half the packets gone: no amount of redundancy on offer saves a picture
    # made of hundreds of fragments.
    ioa::transport::define shredder {
        medium rf nominal_bps 1000000 efficiency 1.0 mtu 250
        latency_ms 5 loss 0.5
    }
    ioa::budget::chooseFec [ioa::transport::link a b shredder] 100000 0.99
} -result {}

test budget-3.3 {an mtu that cannot hold a header is refused} -body {
    ioa::transport::define tiny {medium virtual nominal_bps 1000 mtu 20 latency_ms 1}
    catch {ioa::budget::hop [ioa::transport::link a b tiny] 100} e opts
    lrange [dict get $opts -errorcode] 0 2
} -result {IOA BUDGET MTU}

test budget-4.1 {offered load exceeds the payload rate by the framing cost} -body {
    set l [ioa::transport::link a b espnow {distance_m 10}]
    set offered [ioa::budget::offeredBps $l 4000 10]
    expr {$offered > 4000 * 8 * 10 && $offered < 4000 * 8 * 10 * 1.3}
} -result 1

finish
