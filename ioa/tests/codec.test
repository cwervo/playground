source [file join [file dirname [info script]] harness.tcl]

test codec-1.1 {retreating is always cheaper, from every rung on the ladder} -body {
    # The curated order is by usefulness, so it is not monotonic in bitrate
    # (MJPEG 1080p30 costs five times H.264 1080p30). The descent must be.
    set bad {}
    foreach start [ioa::codec::rungNames] {
        set prev Inf
        foreach r [ioa::codec::descent $start] {
            set b [ioa::codec::bitrate $r]
            if {$b > $prev} { lappend bad "$start -> [dict get $r id]" }
            set prev $b
        }
    }
    set bad
} -result {}

test codec-1.2 {picture bytes are the bitrate divided by the frame rate} -body {
    set r [ioa::codec::rung mj720p30]
    expr {abs([ioa::codec::pictureBytes $r] - [ioa::codec::bitrate $r] / 30.0 / 8.0) <= 1}
} -result 1

test codec-1.3 {intra-only rungs have no keyframe spike} -body {
    set r [ioa::codec::rung mj720p30]
    expr {[ioa::codec::keyframeBytes $r] == [ioa::codec::pictureBytes $r]}
} -result 1

test codec-1.4 {inter-coded rungs do} -body {
    set r [ioa::codec::rung hd1080p60]
    expr {[ioa::codec::keyframeBytes $r] > 3 * [ioa::codec::pictureBytes $r]}
} -result 1

test codec-2.1 {named asks resolve to rungs} -body {
    dict get [ioa::codec::resolve webcam] id
} -result mj720p30

test codec-2.2 {descent starts where you asked and ends at the bottom} -body {
    set d [ioa::codec::descent mj720p30]
    list [dict get [lindex $d 0] id] [dict get [lindex $d end] id]
} -result {mj720p30 mjcrawl}

test codec-2.3 {descent from webcam never proposes a costlier picture} -body {
    # mj1080p15 sits below mj720p30 in the curated order but costs less than
    # nothing would be gained by trying it; it must be skipped, not offered.
    set ids {}
    foreach r [ioa::codec::descent mj720p30] { lappend ids [dict get $r id] }
    expr {"mj1080p15" ni $ids && "mj1080p30" ni $ids}
} -result 1

test codec-3.1 {an mjpeg-only sensor cannot be asked for h264} -body {
    ioa::codec::withinCeiling [ioa::codec::rung hd1080p30] {mjpeg 1600 1200 25}
} -result 0

test codec-3.2 {and cannot be asked for more frames than it has} -body {
    ioa::codec::withinCeiling [ioa::codec::rung mj720p30] {mjpeg 1600 1200 25}
} -result 0

test codec-3.3 {but can be asked for anything at or below its ceiling} -body {
    ioa::codec::withinCeiling [ioa::codec::rung mj720p15] {mjpeg 1600 1200 25}
} -result 1

test codec-3.4 {an h265 encoder can also emit the cheaper codecs} -body {
    ioa::codec::withinCeiling [ioa::codec::rung mj480p30] {h265 1920 1080 60}
} -result 1

test codec-4.1 {the bottom of the ladder fits media measured in kilobits} -body {
    expr {[ioa::codec::bitrate [ioa::codec::rung mjcrawl]] < 2400}
} -result 1

finish
