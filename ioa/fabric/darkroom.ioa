# fabric/darkroom.ioa -- a site where radio is not allowed at all.
#
# An anechoic room, a hospital wing, a radio observatory, a customer who will
# not have another SSID in the building. The pictures leave on light instead:
# diffuse Li-Fi across the room into a Prism, a collimated hop to the far
# building, then copper for the last twenty metres.
#
#   ioa plan --fabric darkroom --from eye-pro --to host --want hd --forbid rf
#
# The cheap ESP32 camera is in this fabric on purpose. It only speaks radio,
# so on this site it is scenery:
#
#   ioa plan --fabric darkroom --from eye-01 --to host --want trickle --forbid rf

fabric "darkroom" {}
site "the quiet building"
device eye-pro {product IOA-EYE-PRO}
device eye-01  {product IOA-EYE-S3}
device relay   {product IOA-RELAY-24}
device prism-a {product IOA-PRISM-L1}
device prism-b {product IOA-PRISM-L1}
device host    {product IOA-HUB-X platform linux}

link eye-pro prism-a lifi     {distance_m 8 ambient_lux 300}
link prism-a prism-b laser    {distance_m 300 alignment 0.98}
link prism-b host    ethernet {distance_m 20 peer 10.0.0.7}
link eye-01  relay   espnow   {distance_m 15}
link relay   host    wifi_tcp {distance_m 20 peer 10.0.0.7}
