fn b64_decode(s: &str) -> Vec<u8> {
    const T: &[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    let idx = |c: u8| T.iter().position(|&t| t == c).unwrap() as u32;
    let bytes: Vec<u8> = s.bytes().filter(|&c| c != b'=' && c != b'\n').collect();
    let mut out = Vec::new();
    for chunk in bytes.chunks(4) {
        let mut acc = 0u32; let mut n = 0;
        for &c in chunk { acc = (acc << 6) | idx(c); n += 1; }
        acc <<= 6 * (4 - n);
        for i in 0..(n * 6 / 8) { out.push((acc >> (16 - 8 * i)) as u8); }
    }
    out
}

fn main() {
    let html = b64_decode(PAYLOAD_B64);
    std::fs::write("WhitePaper.html", &html).expect("write failed");
    println!("reproduced WhitePaper.html ({} bytes)", html.len());
}
