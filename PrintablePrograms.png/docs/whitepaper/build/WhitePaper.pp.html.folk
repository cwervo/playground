set html [encoding convertfrom utf-8 [binary decode base64 $payload]]
if {[info exists ::argv0] && [file tail $::argv0] eq [file tail [info script]]} {
    set f [open WhitePaper.html w]; fconfigure $f -encoding utf-8
    puts -nonewline $f $html; close $f
    puts "reproduced WhitePaper.html ([string length $html] chars)"
} else {
    Claim $this is a printable program named "WhitePaper"
    Wish $this displays html $html
}
