  <commands>
    <command name="#"># hello.tcl -- PrintablePrograms sample program</command>
    <command name="proc">proc greet {who} {
    return &quot;Hello, $who!&quot;
}</command>
    <command name="foreach">foreach name {world folk printable} {
    puts [greet $name]
}</command>
    <command name="#"># a multi-line command with braces, quotes, and &quot;special&quot; &lt;chars&gt; &amp; stuff</command>
    <command name="set">set banner {
