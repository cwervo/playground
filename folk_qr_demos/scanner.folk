    When the image library is /imageLib/ {

    set folkQrPortableQrcodegenDir [file join $folkQrPortableVendorDir qrcodegen]
    set folkQrPortableQuircDir [file join $folkQrPortableVendorDir quirc lib]

    set cc [C]
    $cc extend $imageLib
    $cc include <math.h>
    $cc include <stdatomic.h>
    $cc include <string.h>
    $cc include "qrcodegen.h"
    $cc include "quirc.h"
    $cc cflags -I$folkQrPortableQrcodegenDir -I$folkQrPortableQuircDir
    $cc endcflags \
        [file join $folkQrPortableQrcodegenDir qrcodegen.c] \
        -DQUIRC_MAX_REGIONS=65534 -I$folkQrPortableQuircDir \
        [file join $folkQrPortableQuircDir quirc.c] \
        [file join $folkQrPortableQuircDir identify.c] \
        [file join $folkQrPortableQuircDir decode.c] \
        [file join $folkQrPortableQuircDir version_db.c] \
        -lm -fPIC

    $cc code {
        static _Atomic uint64_t qrImageUniq = 1;
        static __thread struct quirc *qrDecoder = NULL;
        static __thread int qrDecoderWidth = 0;
        static __thread int qrDecoderHeight = 0;

        static void appendDictEntry(Jim_Obj *dict, const char *key, Jim_Obj *value) {
            Jim_ListAppendElement(interp, dict, Jim_NewStringObj(interp, key, -1));
            Jim_ListAppendElement(interp, dict, value);
        }

        static Jim_Obj *pointObj(int x, int y) {
            Jim_Obj *values[2] = {
                Jim_NewIntObj(interp, x),
                Jim_NewIntObj(interp, y),
            };
            return Jim_NewListObj(interp, values, 2);
        }

        static Jim_Obj *cornersObj(struct quirc_code *code) {
            Jim_Obj *points = Jim_NewListObj(interp, NULL, 0);
            for (int j = 0; j < 4; j++) {
                Jim_ListAppendElement(interp, points,
                                      pointObj(code->corners[j].x, code->corners[j].y));
            }
            return points;
        }

        static Jim_Obj *qrCodeObj(struct quirc_code *code, struct quirc_data *data,
                                  bool mirrored) {
            Jim_Obj *codeObj = Jim_NewListObj(interp, NULL, 0);
            appendDictEntry(codeObj, "payload",
                            Jim_NewStringObj(interp, (const char *)data->payload,
                                             data->payload_len));
            appendDictEntry(codeObj, "p", cornersObj(code));
            appendDictEntry(codeObj, "size", Jim_NewIntObj(interp, code->size));
            appendDictEntry(codeObj, "version", Jim_NewIntObj(interp, data->version));
            appendDictEntry(codeObj, "eccLevel", Jim_NewIntObj(interp, data->ecc_level));
            appendDictEntry(codeObj, "mask", Jim_NewIntObj(interp, data->mask));
            appendDictEntry(codeObj, "dataType", Jim_NewIntObj(interp, data->data_type));
            appendDictEntry(codeObj, "eci", Jim_NewIntObj(interp, data->eci));
            appendDictEntry(codeObj, "mirrored", Jim_NewIntObj(interp, mirrored));
            return codeObj;
        }

        static void ensureQrDecoder(int width, int height) {
            if (qrDecoder == NULL) {
                qrDecoder = quirc_new();
                FOLK_ENSURE(qrDecoder != NULL);
            }

            if (qrDecoderWidth != width || qrDecoderHeight != height) {
                if (quirc_resize(qrDecoder, width, height) < 0) {
                    FOLK_ERROR("qrcode: failed to allocate decoder for %dx%d image",
                               width, height);
                }
                qrDecoderWidth = width;
                qrDecoderHeight = height;
            }
        }

        static void loadQrDecoder(Image gray, int *widthOut, int *heightOut) {
            FOLK_ENSURE(gray.components == 1 || gray.components == 3);
            FOLK_CHECK(gray.width <= INT32_MAX && gray.height <= INT32_MAX,
                       "qrcode: image is too large to scan");

            int width = (int)gray.width;
            int height = (int)gray.height;
            ensureQrDecoder(width, height);

            int qrWidth, qrHeight;
            uint8_t *dst = quirc_begin(qrDecoder, &qrWidth, &qrHeight);
            FOLK_ENSURE(qrWidth == width && qrHeight == height);

            if (gray.components == 1 && gray.bytesPerRow == gray.width) {
                memcpy(dst, gray.data, (size_t)height * width);
            } else {
                for (int y = 0; y < height; y++) {
                    uint8_t *srcRow = gray.data + y * gray.bytesPerRow;
                    uint8_t *dstRow = dst + y * width;
                    for (int x = 0; x < width; x++) {
                        if (gray.components == 1) {
                            dstRow[x] = srcRow[x];
                        } else {
                            uint8_t r = srcRow[x * 3];
                            uint8_t g = srcRow[x * 3 + 1];
                            uint8_t b = srcRow[x * 3 + 2];
                            dstRow[x] =
                                (uint8_t)(0.299f * r + 0.587f * g + 0.114f * b + 0.5f);
                        }
                    }
                }
            }

            quirc_end(qrDecoder);
            *widthOut = width;
            *heightOut = height;
        }
    }

    $cc proc qrCodeImage {char* text int pixelsPerModule int border int ecl
                          int minVersion int maxVersion bool boostEcl} Image {
        FOLK_CHECK(pixelsPerModule >= 1 && pixelsPerModule <= 64,
                   "qrcode: pixelsPerModule must be between 1 and 64");
        FOLK_CHECK(border >= 0 && border <= 32,
                   "qrcode: border must be between 0 and 32 modules");
        FOLK_CHECK(ecl >= qrcodegen_Ecc_LOW && ecl <= qrcodegen_Ecc_HIGH,
                   "qrcode: unknown error correction level");
        FOLK_CHECK(minVersion >= qrcodegen_VERSION_MIN &&
                   maxVersion <= qrcodegen_VERSION_MAX &&
                   minVersion <= maxVersion,
                   "qrcode: version range must be between 1 and 40");

        uint8_t qrcode[qrcodegen_BUFFER_LEN_MAX];
        uint8_t temp[qrcodegen_BUFFER_LEN_MAX];
        bool ok = qrcodegen_encodeText(text, temp, qrcode, (enum qrcodegen_Ecc)ecl,
                                       minVersion, maxVersion,
                                       qrcodegen_Mask_AUTO, boostEcl);
        if (!ok) {
            FOLK_ERROR("qrcode: text does not fit in requested QR code version range");
        }

        int moduleCount = qrcodegen_getSize(qrcode);
        int imageSize = (moduleCount + border * 2) * pixelsPerModule;
        Image out = imageNew(imageSize, imageSize, 1, 0);
        out.uniq = atomic_fetch_add(&qrImageUniq, 1);
        memset(out.data, 255, (size_t)out.height * out.bytesPerRow);

        for (int moduleY = 0; moduleY < moduleCount; moduleY++) {
            for (int moduleX = 0; moduleX < moduleCount; moduleX++) {
                if (!qrcodegen_getModule(qrcode, moduleX, moduleY)) {
                    continue;
                }

                int startX = (moduleX + border) * pixelsPerModule;
                int startY = (moduleY + border) * pixelsPerModule;
                for (int y = 0; y < pixelsPerModule; y++) {
                    memset(out.data + (startY + y) * out.bytesPerRow + startX,
                           0, pixelsPerModule);
                }
            }
        }

        return out;
    }

    $cc proc scan {Image gray} Jim_Obj* {
        int width, height;
        loadQrDecoder(gray, &width, &height);

        Jim_Obj *result = Jim_NewListObj(interp, NULL, 0);
        int count = quirc_count(qrDecoder);
        for (int i = 0; i < count; i++) {
            struct quirc_code code;
            struct quirc_data data;
            quirc_extract(qrDecoder, i, &code);

            quirc_decode_error_t err = quirc_decode(&code, &data);
            bool mirrored = false;
            if (err == QUIRC_ERROR_DATA_ECC) {
                quirc_flip(&code);
                err = quirc_decode(&code, &data);
                mirrored = err == QUIRC_SUCCESS;
            }
            if (err != QUIRC_SUCCESS) {
                continue;
            }

            Jim_ListAppendElement(interp, result, qrCodeObj(&code, &data, mirrored));
        }

        return result;
    }

    $cc proc scanDiagnostics {Image gray} Jim_Obj* {
        int width, height;
        loadQrDecoder(gray, &width, &height);

        Jim_Obj *codes = Jim_NewListObj(interp, NULL, 0);
        Jim_Obj *errors = Jim_NewListObj(interp, NULL, 0);

        int count = quirc_count(qrDecoder);
        int decoded = 0;
        int failures = 0;
        for (int i = 0; i < count; i++) {
            struct quirc_code code;
            struct quirc_data data;
            quirc_extract(qrDecoder, i, &code);

            quirc_decode_error_t err = quirc_decode(&code, &data);
            bool mirrored = false;
            if (err == QUIRC_ERROR_DATA_ECC) {
                quirc_flip(&code);
                err = quirc_decode(&code, &data);
                mirrored = err == QUIRC_SUCCESS;
            }

            if (err == QUIRC_SUCCESS) {
                Jim_ListAppendElement(interp, codes, qrCodeObj(&code, &data, mirrored));
                decoded++;
            } else {
                Jim_Obj *errorObj = Jim_NewListObj(interp, NULL, 0);
                appendDictEntry(errorObj, "index", Jim_NewIntObj(interp, i));
                appendDictEntry(errorObj, "error",
                                Jim_NewStringObj(interp, quirc_strerror(err), -1));
                appendDictEntry(errorObj, "p", cornersObj(&code));
                appendDictEntry(errorObj, "size", Jim_NewIntObj(interp, code.size));
                Jim_ListAppendElement(interp, errors, errorObj);
                failures++;
            }
        }

        Jim_Obj *result = Jim_NewListObj(interp, NULL, 0);
        appendDictEntry(result, "width", Jim_NewIntObj(interp, width));
        appendDictEntry(result, "height", Jim_NewIntObj(interp, height));
        appendDictEntry(result, "regions", Jim_NewIntObj(interp, count));
        appendDictEntry(result, "decoded", Jim_NewIntObj(interp, decoded));
        appendDictEntry(result, "failures", Jim_NewIntObj(interp, failures));
        appendDictEntry(result, "codes", codes);
        appendDictEntry(result, "errors", errors);
        return result;
    }

    set qrLib [$cc compile]
    Claim the QR code library is $qrLib
    Claim the portable QR code library is $qrLib

    fn qrEccLevel {value} {
        set value [string tolower $value]
        switch -- $value {
            0 - low { return 0 }
            1 - medium { return 1 }
            2 - quartile - q { return 2 }
            3 - high { return 3 }
            default { error "Unsupported QR code error correction level: $value" }
        }
    }

    fn qrGenerationOptions {options} {
        set pixelsPerModule [dict getdef $options pixelsPerModule \
                                 [dict getdef $options modulePixels 8]]
        set border [dict getdef $options border 4]
        set ecl [qrEccLevel [dict getdef $options ecc \
                                 [dict getdef $options errorCorrection medium]]]
        set minVersion [dict getdef $options minVersion 1]
        set maxVersion [dict getdef $options maxVersion 40]
        set boostEcl [dict getdef $options boostEcl true]
        return [list $pixelsPerModule $border $ecl $minVersion $maxVersion $boostEcl]
    }

    fn qrDrawOptions {options} {
        set drawOptions $options
        foreach key {
            pixelsPerModule modulePixels border ecc errorCorrection minVersion maxVersion boostEcl
        } {
            if {[dict exists $drawOptions $key]} {
                dict unset drawOptions $key
            }
        }
        return $drawOptions
    }

    fn displayQrCode {p text options} {
        fn qrEccLevel
        fn qrGenerationOptions
        fn qrDrawOptions

        lassign [qrGenerationOptions $options] \
            pixelsPerModule border ecl minVersion maxVersion boostEcl
        set im [$qrLib qrCodeImage $text $pixelsPerModule $border \
                    $ecl $minVersion $maxVersion $boostEcl]

        Wish $p displays image $im with {*}[qrDrawOptions $options] \
            -destructor [list $imageLib imageFree $im]
    }

    fn scanQrCodes {scanner source frame frameTs options} {
        set intervalMs [dict getdef $options intervalMs 250]
        set nowMs [clock milliseconds]
        set stateResults [Query! $scanner has QR code scan state /state/]
        if {[llength $stateResults] > 0} {
            set state [dict get [lindex $stateResults 0] state]
            if {[dict exists $state lastStartMs] &&
                $nowMs - [dict get $state lastStartMs] < $intervalMs} {

                return
            }
        }

        Hold! -key [list qrcode-scan-state $scanner] \
            Claim $scanner has QR code scan state \
                [dict create status decoding source $source lastStartMs $nowMs]
        Claim -keep 120ms $scanner is decoding QR codes

        try -signal {
            set qrTime [time {
                if {[dict getdef $options diagnostics false]} {
                    set diagnostics [$qrLib scanDiagnostics $frame]
                    set codes [dict get $diagnostics codes]
                } else {
                    set codes [$qrLib scan $frame]
                }
            }]
        } finally {
            Hold! -key [list qrcode-scan-state $scanner] \
                Claim $scanner has QR code scan state \
                    [dict create status idle source $source lastStartMs $nowMs \
                         lastFinishMs [clock milliseconds]]
        }

        Hold! -key [list qrcode-scan $scanner $source] \
            Claim $scanner detected QR codes $codes from $source \
            at timestamp $frameTs in time $qrTime
        if {[info exists diagnostics]} {
            Hold! -key [list qrcode-scan-diagnostics $scanner $source] \
                Claim $scanner has QR code scan diagnostics $diagnostics from $source \
                at timestamp $frameTs in time $qrTime
        }

        foreach code $codes {
            set payload [dict get $code payload]
            Claim -keep 8ms QR code $payload has detection $code from $source \
                at timestamp $frameTs
            Claim -keep 8ms $scanner decoded QR code $payload \
                with detection $code from $source at timestamp $frameTs
        }
        Claim the QR code scan time is $qrTime
    }

    When /someone/ wishes /p/ displays QR code /text/ with /...options/ {
        if {![info exists options]} { set options {} }

        fn displayQrCode
        displayQrCode $p $text $options
    }

    When /someone/ wishes /scanner/ scans for QR codes with /...options/ &\
         -serially camera /camera/ has gray frame /frame/ at timestamp /frameTs/ {
        if {![info exists options]} { set options {} }
        fn scanQrCodes
        scanQrCodes $scanner [list camera $camera] $frame $frameTs $options
    }

    When /someone/ wishes /scanner/ scans camera /camera/ for QR codes with /...options/ &\
         -serially camera /camera/ has gray frame /frame/ at timestamp /frameTs/ {
        if {![info exists options]} { set options {} }
        fn scanQrCodes
        scanQrCodes $scanner [list camera $camera] $frame $frameTs $options
    }

    When /someone/ wishes /scanner/ scans its camera slice for QR codes with /...options/ {
        if {![info exists options]} { set options {} }

        Wish $scanner has camera slice
    }

    When /someone/ wishes /scanner/ scans its camera slice for QR codes with /...options/ &\
         -serially /scanner/ has camera slice /frame/ {
        if {![info exists options]} { set options {} }
        fn scanQrCodes
        scanQrCodes $scanner camera-slice $frame [expr {[clock milliseconds] / 1000.0}] $options
    }

    }

}

fn portableQrWrap {text {limit 64}} {
    set words [split $text " "]
    set lines [list]
    set line ""
    foreach word $words {
        if {$line eq ""} {
            set line $word
        } elseif {[string length "$line $word"] <= $limit} {
            append line " " $word
        } else {
            lappend lines $line
            set line $word
        }
    }
    if {$line ne ""} { lappend lines $line }
    join $lines "\n"
}

Wish $this has a canvas
Wish $this is titled "portable QR scanner"
Wish $this is outlined gold
Wish $this scans its camera slice for QR codes with intervalMs 350 diagnostics true

When the quad library is /quadLib/ &\
     $this has quad /q/ {
    package require linalg
    namespace import \
        ::math::linearalgebra::add \
        ::math::linearalgebra::sub \
        ::math::linearalgebra::norm \
        ::math::linearalgebra::unitLengthVector

    set preview [list $this camera-slice-preview]
    lassign [$quadLib vertices $q] topLeft topRight bottomRight bottomLeft

    set topWidth [norm [sub $topRight $topLeft]]
    set bottomWidth [norm [sub $bottomRight $bottomLeft]]
    set previewWidth [::math::max $topWidth $bottomWidth]
    set leftHeight [norm [sub $bottomLeft $topLeft]]
    set rightHeight [norm [sub $bottomRight $topRight]]
    set previewHeight [::math::max $leftHeight $rightHeight]

    set heightVectorLeft [sub $bottomLeft $topLeft]
    set heightVectorRight [sub $bottomRight $topRight]
    set downDir [unitLengthVector [::math::linearalgebra::scale 0.5 [add $heightVectorLeft $heightVectorRight]]]
    set gap [expr {$previewWidth * 0.08}]
    set gapVector [::math::linearalgebra::scale $gap $downDir]
    set previewHeightVector [::math::linearalgebra::scale $previewHeight $downDir]

    set previewTopLeft [add $bottomLeft $gapVector]
    set previewTopRight [add $bottomRight $gapVector]
    set previewBottomRight [add $previewTopRight $previewHeightVector]
    set previewBottomLeft [add $previewTopLeft $previewHeightVector]

    Claim $preview has quad \
        [$quadLib create [$quadLib space $q] \
             [list $previewTopLeft $previewTopRight \
                  $previewBottomRight $previewBottomLeft]]
    Claim $preview has resolved geometry \
        [dict create width $previewWidth height $previewHeight]
    Wish $preview has a canvas with width 512 height 512 settle 3ms
    Wish $preview is outlined cyan
    Wish $preview is footnoted "camera slice preview"
}

When $this has camera slice /slice/ &\
     [list $this camera-slice-preview] has resolved geometry /geom/ {
    set preview [list $this camera-slice-preview]
    set nowMs [clock milliseconds]
    set lastResults [Query! $preview has camera slice preview last draw ms /lastMs/]
    if {[llength $lastResults] > 0} {
        set lastMs [dict get [lindex $lastResults 0] lastMs]
        if {$nowMs - $lastMs < 1000} { return }
    }
    Hold! -key [list $preview camera-slice-preview-last-draw] \
        Claim $preview has camera slice preview last draw ms $nowMs

    set sourceWidth [dict get $slice width]
    set sourceHeight [dict get $slice height]
    if {$sourceWidth <= 0 || $sourceHeight <= 0} { return }

    set previewWidth [dict get $geom width]
    set previewHeight [dict get $geom height]
    set drawWidth $previewWidth
    set drawHeight [expr {$drawWidth * double($sourceHeight) / $sourceWidth}]
    if {$drawHeight > $previewHeight} {
        set drawHeight $previewHeight
        set drawWidth [expr {$drawHeight * double($sourceWidth) / $sourceHeight}]
    }
    set x [expr {($previewWidth - $drawWidth) / 2.0}]
    set y [expr {($previewHeight - $drawHeight) / 2.0}]

    Wish to draw an image onto $preview with \
        image $slice position [list $x $y] \
        width $drawWidth height $drawHeight
    Wish $preview is footnoted "camera slice ${sourceWidth}x${sourceHeight}"
}

When $this is decoding QR codes &\
     $this has resolved geometry /geom/ &\
     the clock time is /t/ {
    set inset 0.006
    set w [dict get $geom width]
    set h [dict get $geom height]
    set points [list \
        [list $inset $inset] \
        [list [expr {$w - $inset}] $inset] \
        [list [expr {$w - $inset}] [expr {$h - $inset}]] \
        [list $inset [expr {$h - $inset}]] \
        [list $inset $inset]]
    Wish to draw a dashed line onto $this with \
        points $points width 0.004 color yellow dashlength 0.025 \
        dashoffset [expr {$t * -0.08}] layer 50
}

When $this detected QR codes /codes/ from /source/ at timestamp /ts/ in time /qrTime/ {
    fn portableQrWrap
    if {[llength $codes] == 0} {
        set message "No QR yet"
    } else {
        set payload [dict get [lindex $codes 0] payload]
        set message [portableQrWrap $payload 58]
    }
    Hold! -key [list portable-qr-scanner-result $this] \
        Claim $this has portable QR scanner result $message
}

When $this has QR code scan diagnostics /diagnostics/ from /source/ at timestamp /ts/ in time /qrTime/ {
    set summary "slice [dict get $diagnostics width]x[dict get $diagnostics height], regions [dict get $diagnostics regions], decoded [dict get $diagnostics decoded]"
    Hold! -key [list portable-qr-scanner-diagnostics $this] \
        Claim $this has portable QR scanner diagnostics summary $summary
}

When $this has portable QR scanner result /message/ {
    Wish $this is right-margined $message
}

When $this has portable QR scanner diagnostics summary /summary/ {
    Wish $this is footnoted $summary
}
