# Portable QR bootstrap for Folk main. Generated from ac/qr.
if {![info exists ::folkQrPortableRegistered]} {
    set ::folkQrPortableRegistered 1
    set folkQrPortableVendorDir [file join /tmp folk-qr-portable-cbb1fc8d]
    set ::folkQrPortableVendorDir $folkQrPortableVendorDir

    proc folkQrPortableWriteVendorFile {root rel b64} {
        set path [file join $root {*}[split $rel /]]
        file mkdir [file dirname $path]
        if {[file exists $path]} { return }
        set fd [open $path w]
        fconfigure $fd -translation binary
        puts -nonewline $fd [binary decode base64 $b64]
        close $fd
    }

    file mkdir $folkQrPortableVendorDir

    folkQrPortableWriteVendorFile $folkQrPortableVendorDir qrcodegen/qrcodegen.c {
