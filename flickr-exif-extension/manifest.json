{
  "manifest_version": 3,
  "name": "Flickr EXIF Viewer",
  "version": "0.1.0",
  "description": "View and archive EXIF data from Flickr images.",
  "icons": {
    "48": "icons/icon-48.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.flickr.com/photos/*/*"],
      "js": [
        "lib/exif.js",
        "content_scripts/content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
